# WhatsApp Bot Configuration
# Copy this file to .env and fill in your actual values

# Bot Settings
BOT_NAME=Sosuke
BOT_PREFIX=.

# Database
DB_PATH=./database/

# API Keys (if needed for commands)
# API_KEY=your_api_key_here

# Logging
DEBUG=false

# Server (if applicable)
PORT=3000
HOST=localhost

# Timezone
TIMEZONE=America/Mexico_City
